<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vanta Auto Clicker" Width="910" Height="444" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" AllowsTransparency="True" Background="Transparent" Foreground="#F3F3F3"
        FontFamily="{StaticResource AppFont}" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Border x:Name="WindowShell" Background="#000000" BorderBrush="#363636" BorderThickness="1.5" CornerRadius="24">
    <Grid x:Name="ShellContent">
      <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="72"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" BorderBrush="#222222" BorderThickness="0,0,0,1.5" Background="#000000" CornerRadius="23,23,0,0">
        <Grid Margin="21,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image x:Name="BrandLogo" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"><TextBlock Text="VANTA" FontWeight="Normal" FontSize="18"/><TextBlock Text="AUTO CLICKER" Foreground="#929292" FontSize="9" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#1A1A1A" CornerRadius="9" BorderBrush="#282828" BorderThickness="1.5" Padding="8,4" Margin="0,0,18,0"><TextBlock Text="v1.0.4" FontSize="10" Foreground="#C8C8C8"/></Border>
            <Button x:Name="PinButton" Style="{StaticResource Chrome}" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" ToolTip="Keep Vanta on top" AutomationProperties.Name="Always on top"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource Chrome}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
            <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="Close and stop clicking" AutomationProperties.Name="Close"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="22,9,22,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ListBox x:Name="Navigation" Style="{StaticResource Segments}" Width="320" BorderThickness="0" Background="Transparent" SelectedIndex="0" AutomationProperties.Name="View">
          <ListBoxItem Content="Default"/><ListBoxItem Content="Advanced"/><ListBoxItem Content="Settings"/>
        </ListBox>
        <Button Grid.Column="2" x:Name="TestPadButton" Content="Test pad  &#x2197;" AutomationProperties.Name="Open test pad" Background="Transparent" BorderThickness="0" Foreground="#C8C8C8" FontSize="12" Padding="9,4"/>
      </Grid>
      <ScrollViewer x:Name="ViewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,8,22,10">
        <Grid x:Name="ViewContent">
          <Grid x:Name="DefaultView" IsEnabled="{Binding CanEdit}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="CADENCE" Style="{StaticResource Label}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultAmount" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontWeight="Normal" FontSize="17" AutomationProperties.Name="Rate or delay amount"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding CadenceConnector}" Foreground="#8E8E8E" Margin="7,0"/><ComboBox Width="108" SelectedIndex="{Binding UnitIndex}" AutomationProperties.Name="Time unit"><ComboBoxItem Content="ms"/><ComboBoxItem Content="second"/><ComboBoxItem Content="minute"/><ComboBoxItem Content="hour"/></ComboBox></StackPanel>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding CadenceIndex}" AutomationProperties.Name="Cadence mode"><ComboBoxItem Content="Rate"/><ComboBoxItem Content="Delay"/></ComboBox>
              </Grid>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="ACTIVATION" Style="{StaticResource Label}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                <Button x:Name="DefaultHotkey" Content="{Binding HotkeyText}" ToolTip="Click, then press your preferred shortcut" AutomationProperties.Name="Change activation hotkey"/>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding ActivationIndex}" AutomationProperties.Name="Activation mode"><ComboBoxItem Content="Toggle"/><ComboBoxItem Content="Hold"/></ComboBox>
              </Grid>
            </StackPanel></Border>
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock Text="Mouse button" Foreground="#B4B4B4"/><ComboBox Grid.Column="1" SelectedIndex="{Binding ButtonIndex}" AutomationProperties.Name="Mouse button"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="Right"/></ComboBox></Grid></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" ToolTip="Percentage of each cycle that the mouse button stays pressed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="Click duration" Foreground="#B4B4B4"/><TextBox Grid.Column="1" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Click duration percentage"/><TextBlock Grid.Column="2" Text="%" Foreground="#8E8E8E" HorizontalAlignment="Right"/></Grid></Border>
              <Border Grid.Column="4" Style="{StaticResource Card}" ToolTip="Randomly vary the cycle interval by this percentage"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><CheckBox Content="Variation" IsChecked="{Binding VariationEnabled}" FontSize="12"/><TextBox Grid.Column="1" Text="{Binding VariationText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding VariationEnabled}" AutomationProperties.Name="Speed variation percentage"/><TextBlock Grid.Column="2" Text="%" Foreground="#8E8E8E" HorizontalAlignment="Right"/></Grid></Border>
            </Grid>
          </Grid>
          <Grid x:Name="AdvancedView" Visibility="Collapsed" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource CompactCard}"><StackPanel>
                <TextBlock Text="Cadence" FontWeight="Normal" Margin="0,0,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" AutomationProperties.Name="Advanced rate or delay amount"/>
                  <ComboBox Grid.Column="1" Margin="8,0" SelectedIndex="{Binding UnitIndex}" AutomationProperties.Name="Advanced time unit"><ComboBoxItem Content="ms"/><ComboBoxItem Content="second"/><ComboBoxItem Content="minute"/><ComboBoxItem Content="hour"/></ComboBox>
                  <ListBox Grid.Column="2" Style="{StaticResource Segments}" SelectedIndex="{Binding CadenceIndex}" AutomationProperties.Name="Advanced cadence mode"><ListBoxItem Content="Rate"/><ListBoxItem Content="Delay"/></ListBox>
                </Grid>
                <TextBlock Text="{Binding CadenceDescription}" Foreground="#808080" FontSize="11" Margin="0,8,0,14" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="154"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Hotkey" Foreground="#B4B4B4"/><Button x:Name="AdvancedHotkey" Grid.Column="1" Content="{Binding HotkeyText}" Margin="0,0,8,0" AutomationProperties.Name="Change advanced activation hotkey"/>
                  <ListBox Grid.Column="2" Style="{StaticResource Segments}" SelectedIndex="{Binding ActivationIndex}" AutomationProperties.Name="Advanced activation mode"><ListBoxItem Content="Toggle"/><ListBoxItem Content="Hold"/></ListBox>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Mouse button" Foreground="#B4B4B4"/><ListBox Grid.Column="1" Style="{StaticResource Segments}" SelectedIndex="{Binding ButtonIndex}" AutomationProperties.Name="Advanced mouse button"><ListBoxItem Content="Left"/><ListBoxItem Content="Middle"/><ListBoxItem Content="Right"/></ListBox></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource CompactCard}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Click duration" FontWeight="Normal"/><TextBlock Text="Time held down per cycle" FontSize="11" Foreground="#808080" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Advanced click duration percentage"/><TextBlock Grid.Column="2" Text="%" HorizontalAlignment="Right" Foreground="#8E8E8E"/></Grid></Border>
              <Border Style="{StaticResource CompactCard}" Margin="0,12,0,0"><StackPanel>
                <Grid><TextBlock Text="Limits" FontWeight="Normal"/><CheckBox IsChecked="{Binding LimitEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Enable limits"/></Grid>
                <Grid Margin="0,12,0,0" IsEnabled="{Binding LimitEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions><TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Limit amount"/><ListBox Grid.Column="2" Style="{StaticResource Segments}" SelectedIndex="{Binding LimitIndex}" AutomationProperties.Name="Limit type"><ListBoxItem Content="Clicks"/><ListBoxItem Content="Seconds"/></ListBox></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource CompactCard}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="24"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Speed variation" FontWeight="Normal"/><TextBlock Text="Random timing, up to ±90%" FontSize="11" Foreground="#808080" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding VariationText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding VariationEnabled}" AutomationProperties.Name="Advanced variation percentage"/><TextBlock Grid.Column="2" Text="%" Foreground="#8E8E8E" HorizontalAlignment="Right"/><CheckBox Grid.Column="3" IsChecked="{Binding VariationEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Enable speed variation"/></Grid></Border>
              <Border x:Name="DoubleClickCard" Style="{StaticResource CompactCard}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="24"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Double click" FontWeight="Normal"/><TextBlock Text="Gap between the two clicks" FontSize="11" Foreground="#808080" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DoubleEnabled}" AutomationProperties.Name="Double click gap in milliseconds"/><TextBlock Grid.Column="2" Text="ms" Foreground="#8E8E8E" HorizontalAlignment="Right" FontSize="11"/><CheckBox Grid.Column="3" IsChecked="{Binding DoubleEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Enable double click"/></Grid></Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource CompactCard}"><Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><TextBlock Text="Sequence clicking" FontWeight="Normal"/><CheckBox IsChecked="{Binding SequenceEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Enable sequence clicking"/></Grid>
              <TextBlock Grid.Row="1" Text="Click saved positions in order, then repeat." Foreground="#8E8E8E" FontSize="12" Margin="0,10,0,18" TextWrapping="Wrap"/>
              <Button Grid.Row="2" x:Name="AddPointButton" Content="+  Capture cursor in 3 seconds" Background="#000000" Foreground="#EEEEEE" BorderBrush="{StaticResource AccentOutline}"/>
              <Grid Grid.Row="3" Margin="0,14,0,14" MinHeight="170" MaxHeight="280">
                <ListBox x:Name="PointList" ItemsSource="{Binding Points}" Background="#0B0B0B" BorderBrush="#292929" Foreground="#D4D4D4" Padding="6" FontFamily="{StaticResource AppFont}" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved cursor points">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="PointSurface" Background="#0B0B0B" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="PointSurface" Property="Background" Value="#111111"/><Setter TargetName="PointSurface" Property="BorderBrush" Value="{StaticResource AccentOutline}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PointSurface" Property="BorderBrush" Value="{StaticResource AccentOutline}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel x:Name="EmptySequence" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="&#xE1D9;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#5C5C5C" HorizontalAlignment="Center"/><TextBlock Text="No points yet" FontWeight="Normal" Foreground="#A5A5A5" HorizontalAlignment="Center" Margin="0,13,0,6"/><TextBlock Text="Move your cursor, then press F6." FontSize="11" Foreground="#757575"/></StackPanel>
              </Grid>
              <UniformGrid Grid.Row="4" Rows="1"><Button x:Name="MovePointUp" Content="↑" Margin="0,0,6,0" ToolTip="Move selected point earlier" AutomationProperties.Name="Move point up"/><Button x:Name="MovePointDown" Content="↓" Margin="0,0,6,0" ToolTip="Move selected point later" AutomationProperties.Name="Move point down"/><Button x:Name="RemovePoint" Content="Remove" Margin="0,0,6,0" Padding="4,9"/><Button x:Name="ClearPoints" Content="Clear" Padding="4,9"/></UniformGrid>
              <Border Grid.Row="5" Background="#000000" BorderBrush="#202020" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,16,0,0"><TextBlock Text="F6 captures a point while this view is open. Coordinates use desktop pixels, including other monitors." Foreground="#929292" FontSize="11" TextWrapping="Wrap" LineHeight="17"/></Border>
            </Grid></Border>
          </Grid>
          <StackPanel x:Name="SettingsView" Visibility="Collapsed" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Preferences" FontSize="23" FontWeight="Normal" Margin="0,0,0,6"/>
            <TextBlock Text="Your setup, saved automatically." Foreground="#8E8E8E" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="Keep Vanta above other windows" Margin="0,0,0,18"/>
              <CheckBox IsChecked="{Binding MinimizeOnStart}" Content="Minimize when clicking starts"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
              <TextBlock Text="Safety, built in" FontWeight="Normal" Margin="0,0,0,12"/>
              <TextBlock Foreground="#ACACAC" TextWrapping="Wrap" LineHeight="22"><Run Foreground="#C8C8C8" Text="Esc"/><Run Text=" stops any active run. Mouse buttons are released when a run stops.&#x0a;Vanta stops if the cursor is over its main window. Move to your target before starting.&#x0a;Clicking never starts automatically when the app opens."/></TextBlock>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
              <TextBlock Text="Profiles &amp; preferences" FontWeight="Normal" Margin="0,0,0,8"/>
              <TextBlock Text="Valid changes are saved on this PC. Export a profile to share your setup." Foreground="#8E8E8E" FontSize="12" Margin="0,0,0,14"/>
              <StackPanel Orientation="Horizontal"><Button x:Name="ExportButton" Content="Export profile" Margin="0,0,8,0"/><Button x:Name="ImportButton" Content="Import profile" Margin="0,0,8,0"/><Button x:Name="ResetButton" Content="Reset defaults" Background="Transparent"/><Button x:Name="FontLicenseButton" Content="Font license" Background="Transparent" Margin="8,0,0,0"/></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0"><TextBlock Text="Updates" FontWeight="Normal" Margin="0,0,0,7"/><TextBlock x:Name="UpdateStatus" Text="Updates are checked only when you ask." Foreground="#8E8E8E" FontSize="12" TextWrapping="Wrap"/></StackPanel>
              <Button x:Name="UpdateButton" Grid.Column="1" Content="Check for updates" Background="#000000" BorderBrush="{StaticResource AccentOutline}" VerticalAlignment="Center"/>
            </Grid></Border>
            <TextBlock Text="Vanta Auto Clicker 1.0.4  ·  Windows 10 / 11  ·  No ads. No telemetry.&#x0a;Timing depends on Windows and the target app. Use only where automation is allowed." TextWrapping="Wrap" Foreground="#717171" FontSize="11" Margin="2,18,0,6" LineHeight="19"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border x:Name="NoticeBorder" Grid.Row="3" Margin="22,0,22,8" CornerRadius="12" Background="#000000" BorderBrush="{StaticResource AccentOutline}" BorderThickness="1.5" Padding="11,8" Visibility="Collapsed"><TextBlock x:Name="NoticeText" Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"/></Border>
      <Border Grid.Row="4" Background="#000000" BorderBrush="#202020" BorderThickness="0,1.5,0,0" CornerRadius="0,0,23,23">
        <Grid Margin="22,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#C8C8C8" Margin="0,0,8,0"/><TextBlock x:Name="StatusLabel" Text="Ready" FontWeight="Normal"/><TextBlock x:Name="SessionStats" Text="0 clicks   ·   00:00" Foreground="#7B7B7B" FontSize="11" Margin="16,0,0,0"/></StackPanel><TextBlock x:Name="ShortcutHint" Text="F8 to start  ·  Esc to stop" Foreground="#858585" FontSize="11" Margin="14,5,0,0"/></StackPanel>
          <TextBlock x:Name="FeatureSummary" Grid.Column="1" Text="10 clicks / sec" Foreground="#858585" FontSize="11" VerticalAlignment="Center"/>
          <Button x:Name="StartButton" Grid.Column="3" Content="Start clicking  →" Foreground="#FFFFFF" Background="#000000" BorderBrush="{StaticResource AccentOutline}" FontSize="13"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
